# SETVAR and typed variable names feed command defaults
# Expected state after running 33_sysvars.scr in AutoCAD 2024/2025 from the preamble state.
source: derived from AutoCAD documentation, not yet confirmed in an installed AutoCAD
go-draw: fail
var CIRCLERAD 7.5
var FILLETRAD 3
var OFFSETDIST 4
